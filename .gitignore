# data/: ignore everything except the small result files
data/*
!data/india/
data/india/*
!data/india/analysis/
data/india/analysis/*
!data/india/analysis/classification/
data/india/analysis/classification/*.gpkg

# Python virtual environments (created by setup_env.py)
.venv/
venv/
env/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# R
.Rhistory
.RData
.Rproj.user/
Rplots*.pdf

# Editor / OS
.vscode/
.DS_Store

# One-off patch files (apply them, then delete; the change lives in git history)
*.patch

codebase_dump.txt
